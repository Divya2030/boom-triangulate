# SymbiYosys tasks for the rename freelist.
#
#   bmc   -- bounded search for a property violation
#   prove -- unbounded proof by k-induction / PDR
#   cover -- reachability of the cover statements in freelist_fv.v
#
# The cover task is not optional bookkeeping: unreachable covers are how
# over-constrained assumptions are detected.

[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 40
prove: mode prove
prove: depth 25
cover: mode cover
cover: depth 40

[engines]
bmc:   smtbmc yices
prove: abc pdr
cover: smtbmc yices

[script]
read_verilog -formal -sv -DFORMAL -I. freelist.v
read_verilog -formal -sv -DFORMAL -I. freelist_fv.v
prep -top freelist_fv

[files]
../rtl/freelist.v
../verif/checker.vh
freelist_fv.v
